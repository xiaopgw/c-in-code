{
  "nodeData": {
    "id": "root",
    "topic": "FreeRTOS",
    "root": true,
    "children": [
      {
        "topic": "计数型信号量",
        "id": "042f4863048ab671",
        "children": [
          {
            "topic": "目标：理解计数型信号量如何管理资源池",
            "id": "042f5cb49286a2ca"
          },
          {
            "topic": "场景：模拟有5个车位的停车场，10辆车随机进出",
            "id": "042f6a8a596546ab"
          },
          {
            "topic": "主要是理解各个模块的作用和整体的框架",
            "id": "042f73ad96db6d20"
          }
        ]
      },
      {
        "topic": "互斥量",
        "id": "042f7ab5082fe7e5",
        "children": [
          {
            "topic": "基本概念",
            "id": "042f8fdc04d8e3a6",
            "children": [
              {
                "topic": "信号量是可以由任何任务释放，还有优先级反转的问题，所以需要互斥量，互斥量只有谁上锁谁才能解锁",
                "id": "042f9b6d91aa45a9"
              },
              {
                "topic": "放停车场项目里可以用来防止串口的临界资源占用问题",
                "id": "043005ceab9ca834"
              }
            ]
          },
          {
            "topic": "函数操作接口",
            "id": "042fdf79160c9e32",
            "children": [
              {
                "topic": "创建新的互斥锁对象",
                "id": "042fe11e9ae15dca",
                "children": [
                  {
                    "topic": "osMutexId_t osMutexNew(const osMutexAttr_t *attr);",
                    "id": "042fe5bc90fab058"
                  }
                ]
              },
              {
                "topic": "获取互斥锁所有权",
                "id": "042fe9ed136bfc85",
                "children": [
                  {
                    "topic": "osStatus_t osMutexAcquire(osMutexId_t mutex_id, uint32_t timeout);",
                    "id": "042fec851fe225f7"
                  }
                ]
              },
              {
                "topic": "释放互斥锁所有权",
                "id": "042ff043aac21e82",
                "children": [
                  {
                    "topic": "osStatus_t osMutexRelease(osMutexId_t mutex_id);",
                    "id": "042ff2c626b09a27"
                  }
                ]
              },
              {
                "topic": "删除互斥锁并释放资源",
                "id": "042ff4469b84841d",
                "children": [
                  {
                    "topic": "osStatus_t osMutexDelete(osMutexId_t mutex_id);",
                    "id": "042ff6929a3e95db"
                  }
                ]
              },
              {
                "topic": "获取当前持有互斥锁的任务的ID",
                "id": "042ff93c2d797f69",
                "children": [
                  {
                    "topic": "osThreadId_t osMutexGetOwner(osMutexId_t mutex_id);",
                    "id": "042ffdaf8e6ab271"
                  }
                ]
              }
            ]
          },
          {
            "topic": "优先级反转与优先级继承",
            "id": "04302eb19571c825",
            "children": [
              {
                "topic": "优先级反转",
                "id": "043031dd4c9956e5",
                "children": [
                  {
                    "topic": "普通的信号量",
                    "id": "0430566716a15fe2",
                    "children": [
                      {
                        "topic": "低优先级上锁，此时高优先级抢占时如果同样需要上锁，此时会阻塞，然后只能继续去低优先级的任务，然后此时中优先级抢占，此时会运行中优先级的任务，而中优先级任务没有需要上锁，那就会把高优先级任务杀死",
                        "id": "04306f129875e419"
                      }
                    ]
                  }
                ]
              },
              {
                "topic": "优先级继承",
                "id": "0430372991f5f94c",
                "children": [
                  {
                    "topic": "互斥量内置的一种机制",
                    "id": "04306537d3fca9a1",
                    "children": [
                      {
                        "topic": "防止优先级反转的情况",
                        "id": "0430bb47a9cee04b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
