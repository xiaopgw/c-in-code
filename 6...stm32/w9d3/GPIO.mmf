      },
      {
        "topic": "寄存器",
        "id": "fae1ed26ac4f71b7",
        "children": [
          {
            "topic": "单片机内部的存储单元",
            "id": "fae1eed2b79be878"
          },
          {
            "topic": "对单片机进行设置就是对寄存器改写的过程",
            "id": "fae1f0bebc61dd42"
          },
          {
            "topic": "如果要要控制某个灯量                                                                               （比如配置0x5602 0800(GPIOC端口)和0x5602 0C00(RCC寄存器)）",
            "id": "fb2f9c36fac0f7cf",
            "children": [
              {
                "topic": "打开时钟使能",
                "id": "fb2fa194f3b898ab",
                "children": [
                  {
                    "topic": "*(unsigned int *)0x56020c8c |= (1<<2);",
                    "id": "fb2fdb4de8e531e3"
                  }
                ]
              },
              {
                "topic": "配置端口输出模式",
                "id": "fb2fa3627dd852c6",
                "children": [
                  {
                    "topic": "*(unsigned int *)0x52020800 &= ~(1<<27);\t                          \t\t\t*(unsigned int *)0x52020800 |= (1<<26);",
                    "id": "fb2fddc4e008d5b6"
                  }
                ]
              },
              {
                "topic": "配置端口输出类型",
                "id": "fb2fa6cf16dd7826",
                "children": [
                  {
                    "topic": "*(unsigned int *)0x52020804 &= ~(1<<13);",
                    "id": "fb2fe1f483dd2c06"
                  }
                ]
              },
              {
                "topic": "配置端口输出速度",
                "id": "fb2fac0313769fc6",
                "children": [
                  {
                    "topic": "*(unsigned int *)0x52020808 &= ~(3<<26);",
                    "id": "fb2fe3ade54d797d"
                  }
                ]
              },
              {
                "topic": "配置上下拉寄存器",
                "id": "fb2fb00f78d4700b",
                "children": [
                  {
                    "topic": "*(unsigned int *)0x5202080c &= ~(3<<26);",
                    "id": "fb2fe5ad9eb0fb96"
                  }
                ]
              },
              {
                "topic": "配置输出数据寄存器",
                "id": "fb2fb155ebaab989",
                "children": [
                  {
                    "topic": "*(unsigned int *)0X52020814 |= (1<<13);",
                    "id": "fb2fe6e6fe8b68a9"
                  }
                ]
              }
            ]
          }
        ]
      },
