          {
            "topic": "总线",
            "id": "fa874a597dd964fd",
            "children": [
              {
                "topic": "数据总线",
                "id": "fa874e0ae0ba7f81",
                "children": [
                  {
                    "topic": "cpu与内存或其他器件之间的数据传送的通道",
                    "id": "fa875277e2c551c2"
                  },
                  {
                    "topic": "数据总线的宽度决定的传输的速度",
                    "id": "fa876649ece0f1be"
                  },
                  {
                    "topic": "一根线只能传输一个1/0，所以一个数据线为8的数据总线一次性可以传输8位",
                    "id": "fa876721759aefea"
                  },
                  {
                    "topic": "几根数据线就是多少数据总线",
                    "id": "fa8796d6d871cba4"
                  }
                ]
              },
              {
                "topic": "地址总线",
                "id": "fa874f00771d524a",
                "children": [
                  {
                    "topic": "可以决定指定的存储单元，然后让cpu去找",
                    "id": "fa875d817fc06c93"
                  },
                  {
                    "topic": "决定了能访问多大内存空间",
                    "id": "fa8780b268188500"
                  },
                  {
                    "topic": "几根地址线就是多少地址总线",
                    "id": "fa8789d36d70ea44"
                  }
                ]
              },
              {
                "topic": "控制总线",
                "id": "fa875011ed04ab75",
                "children": [
                  {
                    "topic": "cpu用控制总线对外部器件进行控制",
                    "id": "fa876338fdc51a21"
                  },
                  {
                    "topic": "控制总线的数量决定cpu对外部器件的控制能力",
                    "id": "fa87875fe80d0e53"
                  },
                  {
                    "topic": "几根控制线就是多少控制总线",
                    "id": "fa87a766576da287"
                  }
                ]
              },
              {
                "topic": "总结：",
                "id": "fa87b62e6b3476c7",
                "children": [
                  {
                    "topic": "数据总线决定传输数据的能力",
                    "id": "fa87b702d397eda0"
                  },
                  {
                    "topic": "地址总线决定能用多少内从",
                    "id": "fa87b9aa501a7513"
                  },
                  {
                    "topic": "控制总线决定控制外器的能力",
                    "id": "fa87bd60d42a0091"
                  }
                ]
              }
            ]
          }
        ]
